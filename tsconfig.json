{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "plugins/pi/**/*.ts", "plugins/dsh/**/*.ts", "plugins/claude/src/**/*.ts", "plugins/codex/src/**/*.ts"]
}
