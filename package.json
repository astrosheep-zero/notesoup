{
	"name": "notesoup",
	"version": "0.46.0",
	"type": "module",
	"main": "./dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		},
		"./notes": {
			"types": "./dist/src/notes/index.d.ts",
			"import": "./dist/src/notes/index.js"
		},
		"./package.json": "./package.json",
		"./dsh": {
			"types": "./dist/src/dsh/index.d.ts",
			"import": "./dist/src/dsh/index.js"
		},
		"./dsh/engine": {
			"types": "./dist/src/dsh/engine.d.ts",
			"import": "./dist/src/dsh/engine.js"
		}
	},
	"description": "Codex-style context windows for Pi: durable reset windows, session history tools, and persistent notes.",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"agent-memory",
		"notes"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/astrosheep-zero/notesoup.git"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"files": [
		"src",
		"dist",
		"docs",
		"LICENSE",
		"README.md",
		"playbook.md",
		"skills",
		"mods",
		"!mods/notesoup/types",
		"!mods/notesoup/tsconfig.json",
		"cordis.patch.yml"
	],
	"bin": {
		"dream": "dist/src/pi/dream/cli.js"
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/build-extension.mjs && node -e \"require('node:fs').chmodSync('dist/src/pi/dream/cli.js', 0o755)\"",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p mods/notesoup/tsconfig.json",
		"test": "npm run build && node --test dist/test/*.test.js",
		"prepublishOnly": "npm run typecheck",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*",
		"@deepseek-ai/cordis": "*",
		"@deepseek-ai/cordis-plugin-loader": "*",
		"@deepseek-ai/dsh-agent": "*",
		"@deepseek-ai/dsh-compaction": "*",
		"@deepseek-ai/dsh-commands": "*",
		"@deepseek-ai/dsh-llm": "*",
		"@deepseek-ai/dsh-session": "*",
		"@deepseek-ai/dsh-session-query": "*",
		"@deepseek-ai/dsh-system-prompt": "*",
		"@deepseek-ai/dsh-token-meter": "*",
		"@deepseek-ai/dsh-tools": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-agent-core": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		},
		"@deepseek-ai/cordis": {
			"optional": true
		},
		"@deepseek-ai/cordis-plugin-loader": {
			"optional": true
		},
		"@deepseek-ai/dsh-agent": {
			"optional": true
		},
		"@deepseek-ai/dsh-compaction": {
			"optional": true
		},
		"@deepseek-ai/dsh-commands": {
			"optional": true
		},
		"@deepseek-ai/dsh-llm": {
			"optional": true
		},
		"@deepseek-ai/dsh-session": {
			"optional": true
		},
		"@deepseek-ai/dsh-session-query": {
			"optional": true
		},
		"@deepseek-ai/dsh-system-prompt": {
			"optional": true
		},
		"@deepseek-ai/dsh-token-meter": {
			"optional": true
		},
		"@deepseek-ai/dsh-tools": {
			"optional": true
		}
	},
	"devDependencies": {
		"@deepseek-ai/dsh": "0.2.1-alpha.2",
		"@earendil-works/pi-agent-core": "^1.0.0",
		"@earendil-works/pi-ai": "^1.0.0",
		"@earendil-works/pi-coding-agent": "^1.0.0",
		"@types/node": "^22.19.19",
		"esbuild": "^0.28.2",
		"typebox": "1.3.27",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	}
}
